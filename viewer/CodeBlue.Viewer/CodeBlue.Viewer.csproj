<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>CodeBlue</AssemblyName>
    <RootNamespace>CodeBlue.Viewer</RootNamespace>
    <Version>0.1.0</Version>
    <Product>CodeBlue KVM Viewer</Product>
    <!-- Drawn by tools/make_icon.py; regenerate it there rather than editing the .ico. -->
    <ApplicationIcon>CodeBlue.ico</ApplicationIcon>
    <!-- Lets the project restore and compile on non-Windows hosts (CI, Linux dev boxes). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!--
    Legacy text protocol (DEPRECATED).
    Speaks the line-based "p 136 0 0" format used by the original Arduino firmware.
    Enabled by default until the CodeBlue binary protocol firmware exists.
    Build without it:  dotnet build -p:CodeBlueLegacyProtocol=false
    This option and the code behind it will be removed in a future release.
  -->
  <PropertyGroup>
    <CodeBlueLegacyProtocol Condition="'$(CodeBlueLegacyProtocol)' == ''">true</CodeBlueLegacyProtocol>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CodeBlueLegacyProtocol)' == 'true'">
    <DefineConstants>$(DefineConstants);CODEBLUE_LEGACY_PROTOCOL</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CodeBlueLegacyProtocol)' != 'true'">
    <Compile Remove="Link/LegacyTextLink.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also embedded, so the window shows it however the app is started. -->
    <EmbeddedResource Include="CodeBlue.ico" LogicalName="CodeBlue.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WinForms" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" GeneratePathProperty="true" />
    <PackageReference Include="VideoLAN.LibVLC.Windows.GPL" GeneratePathProperty="true" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <!--
    Copy the GPL libVLC plugins (DirectShow capture among them) ourselves.
    Both libVLC packages define their copy step as a target with the same name,
    CollectVlcFilesToCopyWindows, and MSBuild keeps only the last definition, so
    the GPL package's own copy never runs.

    Only DLLs the core package doesn't already provide are copied, so the two
    packages never compete for the same output file. plugins.dat (libVLC's
    plugin cache) comes from the core package; libVLC scans any plugin the
    cache doesn't list.
  -->
  <Target Name="CodeBlueCopyGplVlcPlugins" BeforeTargets="BeforeBuild"
          Condition="'$(PkgVideoLAN_LibVLC_Windows_GPL)' != ''">
    <ItemGroup>
      <_CodeBlueGplVlcPlugin Include="$(PkgVideoLAN_LibVLC_Windows_GPL)\build\x64\plugins\**\*.dll" />
      <Content Include="@(_CodeBlueGplVlcPlugin)"
               Condition="!Exists('$(PkgVideoLAN_LibVLC_Windows)\build\x64\plugins\%(_CodeBlueGplVlcPlugin.RecursiveDir)%(_CodeBlueGplVlcPlugin.Filename)%(_CodeBlueGplVlcPlugin.Extension)')">
        <Link>libvlc\win-x64\plugins\%(_CodeBlueGplVlcPlugin.RecursiveDir)%(_CodeBlueGplVlcPlugin.Filename)%(_CodeBlueGplVlcPlugin.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

</Project>
